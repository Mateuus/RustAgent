{
  "name": "@rustagent/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Núcleo do RustAgent: supervisor de servidores de Rust, SteamCMD, WebRCON e API REST",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "panel:senha": "tsx scripts/panel-password.ts",
    "rcon": "tsx scripts/rcon.ts",
    "steam:probe": "tsx scripts/steam-probe.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
