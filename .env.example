# ============================================================
#  .env.example  -  configuracao do AGENTE
#
#  ESTE ARQUIVO E UM MODELO, versionado no git.
#  Copie para .env e edite la:
#
#      copy .env.example .env
#
#  ------------------------------------------------------------
#  ####  ISTO NAO CONFIGURA NENHUM SERVIDOR DE RUST  ####
#
#  Cada servidor tem o proprio Configs\<id>.ini, com o hostname,
#  o mapa, as quatro portas e a SENHA DE RCON dele. Aqui e a
#  configuracao do processo que os comanda.
#
#  ------------------------------------------------------------
#  Todas as variaveis sao validadas na inicializacao. Faltando
#  uma obrigatoria, o processo NAO sobe: ele imprime o que esta
#  errado e sai com codigo 1. E intencional - um agente no ar com
#  metade da config e pior que um agente parado.
# ============================================================


# ------------------------------------------------------------
#  API  -  onde o painel e as integracoes batem
# ------------------------------------------------------------

# Interface onde o Fastify escuta.
#
# O padrao 127.0.0.1 aceita SO conexoes da propria maquina.
# Trocar para 0.0.0.0 expoe a API na rede, e isso e uma decisao
# consciente: quem alcanca esta API INSTALA, SOBE E DERRUBA os
# servidores desta maquina.
#
# Se for expor: proxy reverso com TLS na frente (o agente fala
# HTTP puro), firewall restringindo a origem, e senha de painel
# de verdade. O agente RECUSA subir em 0.0.0.0 com a senha do
# modelo ou sem token de API.
AGENT_HOST=127.0.0.1

AGENT_PORT=8787

# Token bearer das INTEGRACOES (scripts, site, bot). O painel nao
# usa isto - ele entra por sessao.
#
# Gere um:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_TOKEN=


# ------------------------------------------------------------
#  PAINEL  -  o login do operador
#
#  Um operador, uma senha. O login por Steam com nivel por
#  servidor volta numa fase seguinte (ver Docs\09-ROADMAP.md).
# ------------------------------------------------------------

PANEL_USER=admin

# A senha NAO fica aqui em texto: fica o hash scrypt dela.
#
# Gere com:
#     npm run panel:senha -w core
#
# O comando pergunta a senha, imprime a linha inteira e nao
# escreve nada em disco - copie e cole aqui.
PANEL_PASSWORD_HASH=

# Teto absoluto da sessao (8 h). Depois disso, entra de novo.
PANEL_SESSION_TTL_MS=28800000


# ------------------------------------------------------------
#  OPERACOES  -  instalar, subir, derrubar, atualizar
# ------------------------------------------------------------

# 1 = as rotas de operacao existem.
#
# ####  ISTO MUDA O QUE O TOKEN SIGNIFICA  ####
#
# Com 1, quem tem o token (ou a sessao) EXECUTA PROGRAMA nesta
# maquina - SteamCMD, RustDedicated, taskkill. Nao ha rota de
# "comando arbitrario", mas a superficie e essa.
#
# 0 faz as rotas nem serem registradas: respondem 404.
OPS_ENABLED=1

# Quanto esperar o RCON responder depois de subir um servidor.
#
# Nao e generosidade: um mapa procedural de 4000 leva minutos
# para gerar, e durante todo esse tempo o processo esta no ar
# sem aceitar ninguem.
SERVER_START_TIMEOUT_MS=900000


# ------------------------------------------------------------
#  STEAM  -  o vigia de atualizacao
# ------------------------------------------------------------

# De quanto em quanto tempo perguntar o buildid publicado.
# A consulta leva ~4 s, NAO baixa nada e e segura com o servidor
# no ar. Ela cede a vez quando ha operacao rodando.
STEAM_UPDATE_CHECK_INTERVAL_MS=900000

# 1 = ao encontrar build novo, dispara o server-auto-update
#     (avisa no chat, conta, salva, encerra, atualiza, sobe).
# 0 = so avisa no painel, com o botao para quem quiser mandar.
#
# Este e o PADRAO DA MAQUINA, e nao a palavra final: o site pode
# gravar uma opiniao POR SERVIDOR (o campo autoUpdate da config
# desejada), e ela vence esta linha, sobrevive ao restart do agente
# e vale na rodada seguinte do vigia. Servidor sem opiniao gravada
# segue o valor daqui.
STEAM_AUTO_UPDATE=1


# ------------------------------------------------------------
#  CAMINHOS
#
#  Vazios = dentro da pasta do projeto. E o que faz "copiar a
#  pasta" ser o backup.
#
#  SERVERS_DIR e o unico que costuma mudar: num dedicado com SSD
#  pequeno e HD grande, as instalacoes vao para o HD e o resto
#  fica com o agente.
# ------------------------------------------------------------

# SERVERS_DIR=F:\RustServers
# STEAMCMD_DIR=
# LOGS_DIR=
# BACKUPS_DIR=
# AGENT_DB_PATH=

# A BIBLIOTECA de plugins: um lugar so para cada .cs, do agente
# inteiro. O que cada servidor usa e copiado daqui - por isso
# atualizar um plugin em cinco servidores e UM upload, e nao
# cinco. Vazio = <raiz do projeto>\Plugins.
# PLUGIN_LIBRARY_DIR=


# ------------------------------------------------------------
#  RUSTMAPS  -  a previa do mapa
#
#  A imagem do mundo que entra no proximo wipe, no painel e (por
#  tabela) para o VIP dentro do jogo.
#
#  ####  ISTO E ENFEITE, E O AGENTE TRATA COMO ENFEITE  ####
#
#  Sem chave, sem rede ou com o rustmaps.com fora do ar, NADA
#  muda: num mundo procedural a seed E o mapa, o terreno nasce no
#  boot do servidor e o wipe acontece igual. O cartao da fila
#  mostra "sem previa" com o motivo, e so.
#
#  A chave sai de rustmaps.com/dashboard e vive AQUI - ela nunca
#  e gravada no banco nem devolvida ao painel. Trocar a chave e
#  editar esta linha e reiniciar o agente.
# ------------------------------------------------------------

# Vazia = o agente nao pede previa nenhuma.
RUSTMAPS_API_KEY=

# 1 = pedir a previa sozinho quando uma seed nova entra na fila.
# 0 = so quando alguem clicar em "gerar previa" na tela.
#
# Uma chave recusada (401/403) desliga isto sozinho ate a proxima
# subida do agente: sem essa trava, uma chave errada bateria na
# API a cada minuto, para sempre.
RUSTMAPS_AUTO_GENERATE=1


# ------------------------------------------------------------
#  LOG
# ------------------------------------------------------------

# trace | debug | info | warn | error
LOG_LEVEL=info

# 1 = saida colorida e legivel (pino-pretty). Use no
# desenvolvimento; em producao deixe 0, que e JSON por linha.
LOG_PRETTY=0

# Quanto o log do JOGO (Logs\<id>\server-<identity>.log) pode ocupar
# em disco, em MB. Passou disso, o agente devolve o comeco do arquivo
# ao disco e guarda so o fim (64 MB), sem parar o servidor.
#
# Quem escreve esse arquivo e o proprio RustDedicated, e um erro em
# laco ja o levou a 46 GB numa execucao so. Depois de conter, o
# Explorer mostra o "Tamanho" grande e o "Tamanho em disco" pequeno:
# o comeco virou buraco, e o fim continua legivel.
GAME_LOG_MAX_MB=1024

# ------------------------------------------------------------
#  SITE OrigemZ  -  a integracao de OzCoin
#
#  ####  ISTO E O INTERRUPTOR DA VIRADA  ####
#
#  SITE_BASE_URL vazia: o saldo mora no banco DESTE agente, e nada
#  fala com o site. Preenchida: o SITE passa a ser o dono do saldo,
#  a loja in-game cobra la, o que o jogador compra no site e
#  entregue aqui dentro, e o painel do site enxerga esta loja.
#
#  A virada e preencher e reiniciar. O saldo local NAO e migrado:
#  sao carteiras diferentes, e somar uma na outra sem alguem mandar
#  seria inventar dinheiro.
#
#  ####  QUEM E CADA SERVIDOR LA NAO MORA AQUI  ####
#
#  O site modela UM Server por servidor de Rust, com um bearer cada.
#  Por isso o SITE_SERVER_ID e o SITE_TOKEN de cada um moram em
#  Configs\<id>.ini, junto da senha de RCON - e Configs\*.ini ja
#  esta no .gitignore por causa disso:
#
#      ; Configs\pvp1.ini
#      SITE_SERVER_ID=RUST01
#      SITE_TOKEN=<o bearer que o site gerou para o pvp1>
#
#  Com UM servidor so em Configs\, as duas linhas abaixo servem de
#  padrao e o .ini pode ficar sem elas. Com dois ou mais, cada um
#  traz o seu: um bearer que vale para todos nao existe, e dois
#  servidores com o mesmo SITE_SERVER_ID derrubam o boot - as duas
#  filas de entrega puxariam as MESMAS tarefas, e o item resgatado
#  num servidor nasceria no outro.
#
#  Ver Docs\20-INTEGRACAO-OZCOIN-AGENT.md.
# ------------------------------------------------------------

# A ORIGEM do site, sem /api no fim e sem barra final.
# Ex.: https://origemznetwork.com
SITE_BASE_URL=

# O SITE_SERVER_ID padrao. So e usado quando existe UM servidor em
# Configs\ e o .ini dele nao traz o proprio. Ele casa por texto
# EXATO no site, maiusculas incluidas: "rust01" e "RUST01" sao dois.
SITE_SERVER_ID=

# O bearer padrao, pela mesma regra do de cima. Com SITE_BASE_URL
# preenchida e este vazio, o agente SOBE assim mesmo, em modo
# pending: ele beacona e nao cobra nada - a loja continua na
# carteira local. E o primeiro degrau da virada, e ele nao custa
# nenhuma compra.
SITE_TOKEN=

# Teto de espera por resposta do site no caminho de um jogador que
# clicou. 5000 nao e chute: o plugin da loja desiste em 8 s
# (Plugins\OrigemZUI.cs:183) e, ao desistir, LIBERA O BOTAO com a
# compra ainda em voo. O agente precisa desistir antes dele, com
# folga para a entrega. A regra e SITE_TIMEOUT_MS + 2000 <= 8000.
SITE_TIMEOUT_MS=5000

# Cadencia do batimento. O site considera "online" quem beaconou
# nos ultimos 5 min. Aceita de 5000 a 300000.
SITE_BEACON_INTERVAL_MS=10000

# Cadencia do pull da fila de entregas. Minimo 5000: o canal do
# agente nao tem limite de requisicao do lado do site, e um laco
# apertado aqui satura o banco DELE.
SITE_DELIVERY_POLL_MS=15000

# Cadencia da reconciliacao de compras presas.
SITE_SETTLE_INTERVAL_MS=60000

# Cadencia do retrato de servidor empurrado para o site (quem esta
# no ar, quantos jogadores, build, maquina, operacao em curso). O
# contrato pede 30000. Aceita de 10000 a 300000.
SITE_STATUS_INTERVAL_MS=30000

# 1 = empurra o retrato periodico. 0 = desliga so ele; loja, fila de
# entregas e beacon continuam iguais. O retrato e TELEMETRIA: nada
# do que ele responde muda loja, carteira ou entrega.
SITE_STATUS_PUSH_ENABLED=1

# 1 = empurra o espelho da loja in-game para o painel do site.
# 0 = a loja continua funcionando e o painel do site nao a ve.
SITE_CATALOG_PUSH_ENABLED=1

# Cadencia da fila de comandos: o admin clica "Reiniciar" no painel
# do site e o servidor reinicia. 10000 e o teto do criterio de
# aceite ("de enfileirado a executando em <=10 s"). Aceita de 5000 a
# 60000: acima disso o botao do site deixa de parecer um botao, e o
# admin clica de novo.
SITE_COMMAND_POLL_MS=10000

# 1 = o agente puxa comandos do site. 0 = desliga so isso.
#
# O QUE VEM POR ESTE CANAL SAO TRES: server-start, server-stop e
# server-restart. Os outros cinco que o agente sabe fazer - instalar,
# atualizar, oxide, auto-update e WIPE - continuam existindo so no
# painel local, por quem esta olhando para a maquina. RCON cru nao
# vem, e wipe nao vem: as duas coisas sao execucao remota arbitraria
# com outro nome.
SITE_COMMANDS_ENABLED=1

# Cadencia da config desejada: o admin grava mapa, seed e hostname no
# site e o .ini daqui passa a ter esses valores. Config e ESTADO, nao
# tarefa: ninguem espera na frente da tela, e a volta que nao mudou
# nada custa um 304 sem corpo. Aceita de 10000 a 300000.
SITE_CONFIG_INTERVAL_MS=30000

# 1 = o agente converge para a config gravada no site. 0 = desliga so
# isso, e a configuracao continua sendo a do painel local.
#
# Quase todos os campos so valem no proximo start do jogo (mapa, seed,
# tamanho do mundo, slots, hostname, descricao, portas, senha do RCON):
# o mundo carregado nao muda de mapa. E isso que o `requiresRestart` do
# ACK diz.
#
# O que NAO atravessa este canal, em nenhuma hipotese: SITE_SERVER_ID e
# SITE_TOKEN. Deixar o site reescrever o proprio pareamento derrubaria
# o canal que o gravou, e o conserto seria presencial.
SITE_CONFIG_PULL_ENABLED=1

# ------------------------------------------------------------
#  A CONFIG DE REDE: loja, kits e VIP vindos do site
# ------------------------------------------------------------
#
# ####  ELE NASCE DESLIGADO, E E O UNICO ASSIM  ####
#
# Todo o resto da integracao ADICIONA coisa. Este canal SUBSTITUI: o
# snapshot do site vira a loja inteira, e o produto que sumiu dele sai
# da vitrine. Ligado por padrao, a primeira versao do site apagaria a
# loja de quem atualizou o agente sem ler nada.
#
# Ligue quando o cadastro do outro lado estiver pronto - e saiba que,
# a partir dai, quem manda na loja e nos kits e o site: editar pelo
# painel local continua funcionando e continua valendo, ate a proxima
# versao de la, que reescreve tudo.
SITE_DOMAIN_PULL_ENABLED=0

# Cadencia da config de rede. Um minuto, e nao os 30 s da config de
# servidor: catalogo muda muito menos que hostname, e o corpo dele e o
# mais pesado que atravessa este canal. Aceita de 15000 a 600000.
SITE_DOMAIN_INTERVAL_MS=60000

# Quais assuntos o site pode escrever, separados por virgula.
# Vazio = todos os que o agente conhece: store, kits, vips.
#
# Serve para adotar um de cada vez. Com SITE_DOMAINS=store, a loja vem
# do site e os kits continuam sendo do painel local.
SITE_DOMAINS=

# O User-Agent das chamadas. Vazio = OrigemZ-Rust-Agent/<versao>.
# Ele existe porque a borda do site recusa clientes HTTP genericos
# com um 403 de corpo em texto puro que se parece com um ban.
SITE_USER_AGENT=

# 1 = quando a rota de prova do site nao existir, fecha uma compra
# indeterminada REPETINDO o debito com a mesma referencia.
# E seguro para o dinheiro NA CHAVE e CARO para o jogador: se nada
# tinha sido cobrado, cobra agora, de alguem que ja saiu. Deixe 0.
SITE_SETTLE_FALLBACK_REDEBIT=0


# ------------------------------------------------------------
#  LOJA  -  o teto de uma compra
#
#  O SITE NAO IMPOE TETO NENHUM: ele so recusa o que passa do
#  saldo. Quem impoe e o agente, e e por isso que esta linha
#  existe. Num painel irmao, a falta dela debitou 60 milhoes de OZ
#  numa requisicao so.
#
#  Ele vale para preco x quantidade, e e aplicado ANTES de falar
#  com o dono do saldo - nem linha de compra e criada.
#
#  0 = sem teto.
# ------------------------------------------------------------
STORE_MAX_OZ_PER_PURCHASE=100000
